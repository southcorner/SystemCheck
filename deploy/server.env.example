# Copy to server.env and fill in. Never commit server.env.

# --- HTTP / TLS ---
SC_LISTEN_ADDR=:8443
SC_TLS_CERT=./certs/server.crt
SC_TLS_KEY=./certs/server.key
# CA used to sign & verify agent client certs (mTLS)
SC_CA_CERT=./certs/ca.crt
SC_CA_KEY=./certs/ca.key

# --- Database (matches docker-compose) ---
DB_USER=systemcheck
DB_PASSWORD=change-me
DB_NAME=systemcheck
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=systemcheck
MINIO_ROOT_PASSWORD=change-me-too
SC_S3_ENDPOINT=127.0.0.1:9000
SC_S3_BUCKET=screenshots
SC_S3_USE_SSL=false

# --- Crypto ---
# 32-byte base64 key used to encrypt screenshot blobs at rest (age/AES-GCM)
SC_SCREENSHOT_KEY=base64:generate-with-openssl-rand-base64-32
# Secret used to sign admin session tokens
SC_SESSION_SECRET=generate-a-long-random-string

# --- Enrollment ---
# Shared secret that mints one-time enrollment tokens for new agents
SC_ENROLL_SECRET=generate-a-long-random-string

# --- Notifications (optional) ---
SC_SMTP_HOST=
SC_SMTP_PORT=587
SC_SMTP_USER=
SC_SMTP_PASSWORD=
SC_ALERT_WEBHOOK=

# --- First admin bootstrap (created on first run if no admins exist) ---
SC_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SC_BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login

# --- Retention (days; 0 disables that class) ---
SC_RETENTION_SCREENSHOTS_DAYS=30
SC_RETENTION_ACTIVITY_DAYS=90
SC_RETENTION_SECURITY_DAYS=180
SC_RETENTION_AUDIT_DAYS=365

# --- Dual-approval to view an individual's screenshots ---
SC_REQUIRE_DUAL_APPROVAL=false

# --- Agent release advertisement (signed self-update) ---
SC_AGENT_LATEST_VERSION=
SC_AGENT_DOWNLOAD_URL=
SC_AGENT_SIGNATURE_B64=
